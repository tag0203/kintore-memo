# 参考実装の Cloudflare Worker を手元で試すときの空プレースホルダです。
# 本番のトークンとデータベース ID は AWS SSM Parameter Store（SecureString）に置く。
# 実際の値は git に置かない。Worker を試すときだけ `wrangler secret put` で渡す。
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Cognito / API（ブラウザに出てよい公開値。秘密ではない）。
# 未設定のままだとログイン画面は出ず、記録もメニューもインメモリモックです。
# Cognito と VITE_API_BASE_URL が両方あると、記録は API Gateway、今日のメニューは DayPlan API です。
# 値は `sam deploy` の Outputs から取る。手順は docs/aws-auth.md。
VITE_COGNITO_REGION=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_API_BASE_URL=
